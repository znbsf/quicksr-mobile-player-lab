@startuml
skinparam defaultFontName Microsoft YaHei UI
skinparam defaultFontSize 15
skinparam defaultFontColor #243247
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam ranksep 26
skinparam nodesep 30
skinparam ArrowColor #64748B
skinparam rectangle {
  BackgroundColor #F5F7FA
  BorderColor #94A3B8
}
top to bottom direction

rectangle "播放器接入\nSuperResolutionActivity / Media3" as PLAYER #E8F1FB
rectangle "帧处理编排\nQuickSrVideoEffect" as EFFECT #E8F1FB
rectangle "推理与输出槽\nQuickSrSession" as SESSION
rectangle "帧身份与阶段计时\nVideoPipelineTelemetry" as TELEMETRY
rectangle "QNN 后端准备\nQnnPluginRuntime" as RUNTIME #E7F3EB

PLAYER --> EFFECT : 配置与帧回调
EFFECT --> SESSION : 调用推理
EFFECT --> TELEMETRY : 记录事件
SESSION --> RUNTIME : 建立会话时配置
@enduml
