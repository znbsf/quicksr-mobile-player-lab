@startuml
skinparam defaultFontName Microsoft YaHei UI
skinparam defaultFontSize 15
skinparam defaultFontColor #243247
skinparam backgroundColor white
skinparam shadowing false
skinparam roundcorner 8
skinparam ranksep 24
skinparam ArrowColor #64748B
skinparam rectangle {
  BackgroundColor #F5F7FA
  BorderColor #94A3B8
}
top to bottom direction

rectangle "输入纹理\n640×360 · RGBA8" as INPUT #E8F1FB
rectangle "模型输入缓冲\nfloat32 · NCHW" as CPU_IN
rectangle "QuickSR 3×\nQNN HTP" as QNN #E7F3EB
rectangle "模型输出缓冲\nfloat32 · NHWC" as CPU_OUT
rectangle "显示纹理\n1920×1080 · RGBA8" as OUTPUT #E8F1FB

INPUT --> CPU_IN : GL 读回、归一化
CPU_IN --> QNN : 提交输入
QNN --> CPU_OUT : 写入预分配输出
CPU_OUT --> OUTPUT : CPU 打包、GL 上传
@enduml
