@startuml
skinparam defaultFontName Microsoft YaHei UI
skinparam defaultFontSize 15
skinparam defaultFontColor #243247
skinparam backgroundColor white
skinparam shadowing false
skinparam ArrowColor #64748B
skinparam timing {
  FontColor #243247
  LineColor #64748B
}

concise "推理 / QNN" as QNN
concise "后处理 / Java" as CPU
concise "上传提交 / GL" as GL
scale 1 as 90 pixels

@0
QNN is "N+1" #E7F3EB
CPU is "N" #F1F3F6
GL is "N−1" #E8F1FB

@1
QNN is "N+2" #E7F3EB
CPU is "N+1" #F1F3F6
GL is "N" #E8F1FB

@2
QNN is "N+3" #E7F3EB
CPU is "N+2" #F1F3F6
GL is "N+1" #E8F1FB

@3
QNN is "N+4" #E7F3EB
CPU is "N+3" #F1F3F6
GL is "N+2" #E8F1FB
@enduml
