@startuml
title 三段有界流水线：跨帧并行

skinparam defaultFontName Noto Sans SC
skinparam backgroundColor white
skinparam shadowing false
hide footbox
skinparam sequence {
  ArrowColor #475569
  LifeLineBorderColor #64748B
  LifeLineBackgroundColor #F8FAFC
  ParticipantBorderColor #64748B
  ParticipantBackgroundColor #E0F2FE
  ParticipantFontColor #0F172A
  GroupBorderColor #94A3B8
  GroupBackgroundColor #F8FAFC
}

participant "Media3\n解码" as MEDIA
participant "推理\nQNN HTP" as INFER
participant "后处理\nNEON" as POST
participant "输出\nMedia3 / SF" as OUTPUT

MEDIA -> INFER : N：纹理 + frameId / PTS
INFER -> POST : N：输出租约

par 推理 N+1
  MEDIA -> INFER : N+1
  INFER -> INFER : inference
else 后处理 N
  POST -> POST : copy + RGB→RGBA
end

POST -> OUTPUT : N：RGBA + 原 PTS
OUTPUT -> OUTPUT : present

note over INFER, POST
  容量 = 2；过载时受控退化，不无限排队。
end note
@enduml
