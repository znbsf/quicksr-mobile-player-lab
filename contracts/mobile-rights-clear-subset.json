  "repository_policy": {
    "source_only": true,
    "media_cache_root": "build/pc-benchmark/assets",
    "local_artifact_root": "local-artifacts/mobile-subset",
    "raw_media_must_remain_git_ignored": true,
    "network_downloads_permitted": false,
    "overwrite_permitted": false
  },
  "content_policy": {
    "layout_policy": "fit-pad-no-stretch",
    "fit_pad_background_rgb": [0, 0, 0],
    "commercial_anime_permitted": false,
    "source_assets_must_be_pinned_in_open_assets_manifest": true,
    "required_attribution_is_inherited_from_source_assets_manifest": true
  },
  "cadence_policy": {
    "bbb_sequence_native_fps": 15,
    "target_fps_conversion": "repeat-hold-previous-source-frame",
    "target_24_or_30fps_is_not_native_24_or_30fps_motion": true
  },
  "android_matrix_compatibility": {
    "warmup_frames": 15,
    "minimum_measured_frames": 120,
    "minimum_encoded_frames": 135,
    "rule": "Every generated clip must contain at least warmup_frames + minimum_measured_frames so it can satisfy the matrix frame-count gate without playback looping."
  },
  "materialization": {
    "container": "mp4",
    "video_codec": "libx264",
    "pixel_format": "yuv420p",
    "encoder_options": {
      "crf": 28,
      "preset": "medium",
      "threads": 1,
      "audio": "none",
      "creation_time_utc": "1970-01-01T00:00:00Z"
    },
    "local_manifest_file": "local-materialization-manifest.json",
    "record_per_clip": [
      "derived_mp4_bytes",
      "derived_mp4_sha256",
      "source_file_sha256",
      "frame_pts_us",
      "ffmpeg_identity",
      "pillow_identity"
    ]
  },
  "degradation_profiles": {
    "clean-lanczos": {
      "pre_blur_radius": 0.0,
      "jpeg_quality": null,
      "jpeg_subsampling": null
    },
    "blur-jpeg-q35": {
      "pre_blur_radius": 0.6,
      "jpeg_quality": 35,
      "jpeg_subsampling": 2
    }
  },
  "comparison_policy": {
    "pc_cpu_golden": "required-per-selected-frame-after-materialization",
    "lanczos_baseline": "required-per-selected-frame-after-materialization",
    "legacy_p0_gradient_golden_may_substitute": false,
    "phone_screenshot_is_numerical_evidence": false,
    "selected_model_output_or_raw_tensor_required": true
  },
