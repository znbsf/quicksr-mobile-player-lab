{
  "schema_version": 1,
  "plan_id": "android-qnn-resolution-matrix-v1",
  "app_package": "dev.aisystems.quicksrplayerlab",
  "activity": "dev.aisystems.quicksrplayerlab/.SuperResolutionActivity",
  "telemetry_tag": "QuickSRBenchmark",
  "intent_extras": {
    "run_id": "dev.aisystems.quicksrplayerlab.extra.BENCHMARK_RUN_ID",
    "video_mode": "dev.aisystems.quicksrplayerlab.extra.VIDEO_MODE",
    "video_profile": "dev.aisystems.quicksrplayerlab.extra.VIDEO_PROFILE",
    "video_tuning": "dev.aisystems.quicksrplayerlab.extra.VIDEO_TUNING"
  },
  "device_requirements": {
    "abi": "arm64-v8a",
    "reject_emulator": true,
    "qnn_runtime_expected": true
  },
  "warmup_frames": 15,
  "performance_classes": {
    "realtime_30": {"maximum_p95_total_ms": 33.33, "minimum_observed_fps": 28.5},
    "realtime_24": {"maximum_p95_total_ms": 41.67, "minimum_observed_fps": 22.8}
  },
  "cases": [
    {
      "id": "720p-baseline",
      "priority": "baseline",
      "profile": "FULL_720P",
      "model_input": [640, 360],
      "model_output": [1280, 720],
      "canvas": [1280, 720],
      "native_neural_output": true,
      "minimum_measured_frames": 120,
      "run_seconds": 30
    },
    {
      "id": "1080p-primary",
      "priority": "primary",
      "profile": "FULL_1080P_3X",
      "model_input": [640, 360],
      "model_output": [1920, 1080],
      "canvas": [1920, 1080],
      "native_neural_output": true,
      "minimum_measured_frames": 120,
      "run_seconds": 30
    },
    {
      "id": "1440p-experimental",
      "priority": "experimental",
      "profile": "FULL_1440P_4X",
      "model_input": [640, 360],
      "model_output": [2560, 1440],
      "canvas": [2560, 1440],
      "native_neural_output": true,
      "minimum_measured_frames": 60,
      "run_seconds": 30
    },
    {
      "id": "4k-display-fallback",
      "priority": "fallback",
      "profile": "DISPLAY_4K_FROM_1080P_3X",
      "model_input": [640, 360],
      "model_output": [1920, 1080],
      "canvas": [3840, 2160],
      "native_neural_output": false,
      "minimum_measured_frames": 60,
      "run_seconds": 30
    }
  ]
}
